{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["agentkit/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "chatkit-frontend", "archive", "lambda_*", "lambda", "orchestrator"]
}
